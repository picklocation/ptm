# Supabase is the new hosted backend. Local mode remains available offline.
DATA_BACKEND=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Supabase staff session expires after at most one hour; sign in again when prompted.
ENABLE_DEMO_CONTENT=true
NEXT_PUBLIC_DEMO_MODE=true
SITE_URL=http://localhost:3000
# Generate a long random password. Run npm run seed after setting this.
LOCAL_ADMIN_EMAIL=owner@pickthemap.local
LOCAL_ADMIN_PASSWORD=
SESSION_SECRET=
# Firebase emulator configuration (Java 21+ and Firebase CLI required)
FIREBASE_PROJECT_ID=demo-pickthemap
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-pickthemap.appspot.com
# Cloud: remove emulator variables and configure server-only credentials securely.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
# Digits with country code, no +. Leave empty until business number supplied.
WHATSAPP_NUMBER=
# Absolute local workbook path; worker defaults to .local/enquiries.xlsx
EXCEL_PATH=
# Optional notification adapter. Never affects enquiry persistence.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
