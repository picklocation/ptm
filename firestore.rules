rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   // Application uses a server gateway. No direct client writes or private reads.
   match /publishedContent/{id} { allow read: if resource.data.status == 'published' && resource.data.demo == false; allow write: if false; }
   match /{document=**} { allow read, write: if false; }
 }
}
